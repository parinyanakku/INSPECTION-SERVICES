<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ProElite Inspection" Language="1033" Manufacturer="TEAM INSPECTION SERVICES"
           Version="$(var.PackageVersion)" UpgradeCode="C0862812-A459-4BE8-82B4-E9BB509601EF">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer ProElite Inspection launcher is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <Property Id="INSTALLDIR" Secure="yes">
      <RegistrySearch Id="PreviousInstallDir" Root="HKCU" Key="Software\Team Inspection Services\ProElite" Name="InstallDir" Type="raw" Win64="yes" />
    </Property>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ProElite Inspection" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <WixVariable Id="WixUILicenseRtf" Value="PilotNotice.rtf" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>
    <Icon Id="PackageIcon.ico" SourceFile="package.ico" />
    <Icon Id="AppIcon.ico" SourceFile="home.ico" />
    <Property Id="ARPPRODUCTICON" Value="PackageIcon.ico" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="ProElite Inspection">
          <Component Id="Launcher" Guid="5B2DF92E-0684-4D83-8B15-1410A72D328B" Win64="yes">
            <File Id="AppExe" Source="$(var.LauncherFile)" Name="ProElite.exe" />
            <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="ProElite Inspection"
                      Target="[#AppExe]" WorkingDirectory="INSTALLDIR" Icon="AppIcon.ico" />
            <File Id="WebViewCore" Source="$(var.NativeDir)\Microsoft.Web.WebView2.Core.dll" />
            <File Id="WebViewForms" Source="$(var.NativeDir)\Microsoft.Web.WebView2.WinForms.dll" />
            <File Id="WebViewLoader" Source="$(var.NativeDir)\WebView2Loader.dll" />
            <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Team Inspection Services\ProElite" Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
            <RegistryValue Root="HKCU" Key="Software\Team Inspection Services\ProElite" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="28EC31CD-7439-4E34-B7FD-90AC255C665E" Win64="yes">
          <Shortcut Id="DesktopLink" Name="ProElite Inspection (Native)" Target="[#AppExe]" WorkingDirectory="INSTALLDIR" Icon="AppIcon.ico" />
          <RegistryValue Root="HKCU" Key="Software\Team Inspection Services\ProElite" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="ProductFeature" Title="ProElite Inspection" Level="1"><ComponentRef Id="Launcher" /><ComponentRef Id="DesktopShortcut" /></Feature>
  </Product>
</Wix>
